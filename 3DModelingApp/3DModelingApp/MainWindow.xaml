<Window x:Class="3DModelingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="3D Modeling App - 3 Printers" Height="700" Width="1200"
        WindowState="Maximized">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="Добавить Куб" Click="AddCube_Click" Margin="5"/>
                <Button Content="Добавить Сферу" Click="AddSphere_Click" Margin="5"/>
                <Button Content="Добавить Цилиндр" Click="AddCylinder_Click" Margin="5"/>
                <Separator/>
                <Button Content="Экспорт STL" Click="ExportSTL_Click" Margin="5"/>
                <Button Content="Экспорт OBJ" Click="ExportOBJ_Click" Margin="5"/>
                <Separator/>
                <Button Content="Очистить сцену" Click="ClearScene_Click" Margin="5"/>
            </ToolBar>
        </ToolBarTray>
        
        <!-- 3D Viewport -->
        <hx:HelixViewport3D x:Name="MainViewport" Grid.Row="1" 
                           ZoomExtentsWhenLoaded="True"
                           ShowCoordinateSystem="True"
                           CoordinateSystemLabelForeground="White">
            
            <!-- Default Lighting -->
            <hx:DefaultLights/>
            
            <!-- Models will be added here dynamically -->
            
        </hx:HelixViewport3D>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к работе. Добавьте 3D модели."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ModelCountText" Text="Моделей: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
