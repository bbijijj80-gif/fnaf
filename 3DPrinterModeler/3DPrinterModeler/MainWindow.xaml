<Window x:Class="_3DPrinterModeler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="3D Printer Modeler - Создание моделей для 3D печати" 
        Height="700" Width="1000"
        Background="#FF2B2B2B">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Панель инструментов -->
        <ToolBarTray Grid.Row="0" Background="#FF3C3C3C">
            <ToolBar BandIndex="0" Band="0">
                <Button Content="📦 Куб" Click="AddCube_Click" Padding="10,5" Margin="2" ToolTip="Добавить куб"/>
                <Button Content="🔵 Сфера" Click="AddSphere_Click" Padding="10,5" Margin="2" ToolTip="Добавить сферу"/>
                <Button Content="🛢️ Цилиндр" Click="AddCylinder_Click" Padding="10,5" Margin="2" ToolTip="Добавить цилиндр"/>
                <Separator/>
                <Button Content="🗑️ Удалить выбранное" Click="DeleteSelected_Click" Padding="10,5" Margin="2" ToolTip="Удалить выбранный объект"/>
                <Button Content="🧹 Очистить всё" Click="ClearAll_Click" Padding="10,5" Margin="2" ToolTip="Очистить сцену"/>
                <Separator/>
                <TextBlock Text="Масштаб:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="White"/>
                <TextBox x:Name="ScaleBox" Text="1.0" Width="50" Margin="2" VerticalContentAlignment="Center"/>
                <Button Content="Применить масштаб" Click="ApplyScale_Click" Padding="10,5" Margin="2"/>
            </ToolBar>
        </ToolBarTray>
        
        <!-- 3D Viewport -->
        <hx:HelixViewport3D x:Name="MainViewport" Grid.Row="1" 
                           ZoomExtentsWhenLoaded="True"
                           ShowCoordinateSystem="True"
                           CoordinateSystemLabelPosition="TopRight"
                           Background="#FF1E1E1E">
            
            <!-- Свет -->
            <hx:AmbientLight Color="#FF404040"/>
            <hx:DirectionalLight Color="#FFFFFFFF" Direction="-1,-1,-1"/>
            <hx:DirectionalLight Color="#FF808080" Direction="1,1,1"/>
            
            <!-- Сетка -->
            <hx:GridLinesVisual3D Width="100" Length="100" 
                                  MinorDistance="1" MajorDistance="10" 
                                  Thickness="0.01"
                                  Fill="#FF404040"/>
            
            <!-- Модель будет добавлена здесь -->
        </hx:HelixViewport3D>
        
        <!-- Панель экспорта -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="10"
                    Background="#FF3C3C3C" Padding="10">
            <TextBlock Text="Экспорт модели:" VerticalAlignment="Center" 
                       Foreground="White" Margin="0,0,10,0"/>
            <Button Content="📤 Экспорт в STL" Click="ExportSTL_Click" 
                    Padding="15,8" Margin="5" Background="#FF007ACC" 
                    Foreground="White" BorderThickness="0"/>
            <Button Content="📤 Экспорт в OBJ" Click="ExportOBJ_Click" 
                    Padding="15,8" Margin="5" Background="#FF007ACC" 
                    Foreground="White" BorderThickness="0"/>
            <Button Content="📤 Экспорт в 3MF" Click="Export3MF_Click" 
                    Padding="15,8" Margin="5" Background="#FF007ACC" 
                    Foreground="White" BorderThickness="0"/>
            <Separator Orientation="Vertical" Margin="10,0"/>
            <TextBlock x:Name="StatusText" Text="Готов к работе" 
                       VerticalAlignment="Center" Foreground="#FF90EE90"/>
        </StackPanel>
    </Grid>
</Window>
