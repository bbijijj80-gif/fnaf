<Window x:Class="ModelingApp3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="3D Printer Modeler - Создание 3D моделей для 3D печати" 
        Height="700" Width="1000"
        Background="#FF2B2B2B">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Левая панель инструментов -->
        <Border Grid.Column="0" Background="#FF3C3C3C" BorderBrush="#FF505050" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="3D Printer Modeler" FontSize="18" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    
                    <!-- Создание примитивов -->
                    <GroupBox Header="Создание моделей" Foreground="White" BorderBrush="#FF505050" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <Button Content="➕ Куб" Click="AddCube_Click" Margin="0,5" 
                                    Background="#FF4A90E2" Foreground="White" Padding="10,5"/>
                            <Button Content="➕ Сфера" Click="AddSphere_Click" Margin="0,5" 
                                    Background="#FF4A90E2" Foreground="White" Padding="10,5"/>
                            <Button Content="➕ Цилиндр" Click="AddCylinder_Click" Margin="0,5" 
                                    Background="#FF4A90E2" Foreground="White" Padding="10,5"/>
                            <Button Content="➕ Конус" Click="AddCone_Click" Margin="0,5" 
                                    Background="#FF4A90E2" Foreground="White" Padding="10,5"/>
                            <Button Content="➕ Тор (Пончик)" Click="AddTorus_Click" Margin="0,5" 
                                    Background="#FF4A90E2" Foreground="White" Padding="10,5"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Параметры модели -->
                    <GroupBox Header="Параметры" Foreground="White" BorderBrush="#FF505050" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <TextBlock Text="Размер:" Foreground="#FFB0B0B0" Margin="0,0,0,5"/>
                            <Slider x:Name="SizeSlider" Minimum="0.5" Maximum="5" Value="1" 
                                    TickFrequency="0.5" TickPlacement="BottomRight" 
                                    Margin="0,0,0,10"/>
                            <TextBlock x:Name="SizeValueText" Text="1.0" Foreground="White" 
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Text="Цвет:" Foreground="#FFB0B0B0" Margin="0,10,0,5"/>
                            <ComboBox x:Name="ColorComboBox" Margin="0,0,0,10">
                                <ComboBoxItem Content="Синий" Tag="#FF4A90E2" IsSelected="True"/>
                                <ComboBoxItem Content="Красный" Tag="#FFE74C3C"/>
                                <ComboBoxItem Content="Зеленый" Tag="#FF2ECC71"/>
                                <ComboBoxItem Content="Желтый" Tag="#FFF1C40F"/>
                                <ComboBoxItem Content="Фиолетовый" Tag="#FF9B59B6"/>
                                <ComboBoxItem Content="Оранжевый" Tag="#FFE67E22"/>
                                <ComboBoxItem Content="Белый" Tag="#FFECF0F1"/>
                                <ComboBoxItem Content="Черный" Tag="#FF2C3E50"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Экспорт -->
                    <GroupBox Header="Экспорт" Foreground="White" BorderBrush="#FF505050" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <Button Content="📤 Экспорт в STL" Click="ExportSTL_Click" Margin="0,5" 
                                    Background="#FF27AE60" Foreground="White" Padding="10,5"/>
                            <Button Content="📤 Экспорт в OBJ" Click="ExportOBJ_Click" Margin="0,5" 
                                    Background="#FF27AE60" Foreground="White" Padding="10,5"/>
                            <Button Content="📤 Экспорт в 3MF" Click="Export3MF_Click" Margin="0,5" 
                                    Background="#FF27AE60" Foreground="White" Padding="10,5"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Управление сценой -->
                    <GroupBox Header="Сцена" Foreground="White" BorderBrush="#FF505050" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <Button Content="🗑️ Удалить выбранное" Click="DeleteSelected_Click" Margin="0,5" 
                                    Background="#FFE74C3C" Foreground="White" Padding="10,5"/>
                            <Button Content="🗑️ Очистить всё" Click="ClearAll_Click" Margin="0,5" 
                                    Background="#FFC0392B" Foreground="White" Padding="10,5"/>
                            <Button Content="🔄 Сброс камеры" Click="ResetCamera_Click" Margin="0,5" 
                                    Background="#FF3498DB" Foreground="White" Padding="10,5"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Информация -->
                    <GroupBox Header="Информация" Foreground="White" BorderBrush="#FF505050">
                        <StackPanel Margin="5">
                            <TextBlock x:Name="ObjectCountText" Text="Объектов: 0" 
                                       Foreground="#FFB0B0B0" Margin="0,0,0,5"/>
                            <TextBlock x:Name="SelectedObjectText" Text="Выбрано: нет" 
                                       Foreground="#FFB0B0B0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- 3D Viewport -->
        <Grid Grid.Column="1">
            <hx:HelixViewport3D x:Name="MainViewport" 
                                Background="#FF1E1E1E"
                                ZoomExtentsWhenLoaded="True"
                                ShowCoordinateSystem="True"
                                CoordinateSystemLabelForeground="White">
                
                <!-- Освещение -->
                <hx:AmbientLight Color="#FF404040"/>
                <hx:DirectionalLight Color="White" Direction="-1,-1,-1"/>
                <hx:DirectionalLight Color="#FF808080" Direction="1,1,1"/>
                
                <!-- Сетка -->
                <hx:GridLinesVisual3D Width="10" Length="10" 
                                      MinorDistance="1" MajorDistance="2" 
                                      Stroke="#FF505050" Thickness="0.01"/>
                
                <!-- Модель будет добавляться здесь -->
            </hx:HelixViewport3D>
            
            <!-- Подсказки -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="10" Background="#AA000000" CornerRadius="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="🖱️ ЛКМ + перетаскивание: Вращение" 
                               Foreground="White" FontSize="12"/>
                    <TextBlock Text="🖱️ ПКМ + перетаскивание: Перемещение" 
                               Foreground="White" FontSize="12"/>
                    <TextBlock Text="🖱️ Колесо: Масштабирование" 
                               Foreground="White" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
